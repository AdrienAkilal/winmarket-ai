# ============================================================================
# WinMarket AI - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# API KEYS & CREDENTIALS
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxx-your-key-here-xxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

PAPPERS_API_TOKEN=your-pappers-api-token-here

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# Model selection
LLM_MODEL_PRIMARY=claude-3-5-sonnet-20241022
LLM_MODEL_FALLBACK=  # Optional: fallback model if primary fails (e.g., claude-3-opus-20240229)
LLM_ENABLED=true

# Timeouts and token limits
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# Retry policy
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0
LLM_RETRY_INITIAL_DELAY=1.0

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0

# ============================================================================
# RAG (Retrieval-Augmented Generation) CONFIGURATION
# ============================================================================
RAG_ENABLED=true
RAG_MIN_SCORE_THRESHOLD=0.15
RAG_TOP_K_RESULTS=5
RAG_CACHE_TTL_SECONDS=3600

# Semantic search (requires embedding model)
RAG_USE_EMBEDDINGS=false
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# EXTERNAL API CONFIGURATION
# ============================================================================
PAPPERS_ENABLED=true
PAPPERS_TIMEOUT_SECONDS=8
PAPPERS_MAX_RETRIES=2

# Rate limiting (calls per period)
API_RATE_LIMIT_CALLS=100
API_RATE_LIMIT_PERIOD_SECONDS=60

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_DOCUMENT_GENERATION=true
FEATURE_AUTO_SCORING=true
FEATURE_CAPACITY_ANALYSIS=true
FEATURE_COMPANY_ENRICHMENT=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT_JSON=false  # true for JSON structured logs, false for colored console
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ============================================================================
# VALIDATION & CONSTRAINTS
# ============================================================================
MAX_DOCUMENT_SIZE_MB=50
MAX_AO_TEXT_LENGTH=50000  # Max characters for AO extraction
MIN_EXTRACTION_CONFIDENCE=0.5

# ============================================================================
# BUSINESS LOGIC CONFIGURATION
# ============================================================================
# Scoring thresholds
SCORING_THRESHOLD_GO=88
SCORING_THRESHOLD_SOUS_RESERVE=60

# Capacity management
CAPACITY_LOAD_THRESHOLD_WARNING=0.85  # 85% = warning
CAPACITY_LOAD_THRESHOLD_CRITICAL=0.95  # 95% = critical

# ============================================================================
# OPTIONAL: Database Configuration (for future expansion)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost/winmarket_ai
# DATABASE_POOL_SIZE=5

# ============================================================================
# OPTIONAL: Caching Backend (Redis)
# ============================================================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_TTL_SECONDS=3600

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=true  # Set to false in production
